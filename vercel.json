{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "functions": { "api/index.js": { "includeFiles": "views/**", "maxDuration": 30 } },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
