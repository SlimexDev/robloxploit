<%- include('partials/head') %><main class="container admin-page" id="main"><%- include('partials/admin-nav') %>
<div class="section-heading"><div><h2>Advertisements</h2><p>Choose a placement, select its content type, then enable it when ready.</p></div></div>
<form method="post" action="/robloxploit-slimexdev/ads" class="form-panel"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% for (const slot of ['banner', 'popup']) { const ad = config[slot] || {}; const type = ad.type || 'embed'; %>
<fieldset class="task-editor-row" data-ad-editor><legend><%= slot === 'banner' ? 'Top banner' : 'Popup overlay' %></legend>
<p class="field-help"><%= slot === 'banner' ? 'Below the header on home, script and code pages. Recommended: 728 × 90.' : 'A closable overlay on public pages. Recommended: 600 × 400. Appears once per page visit.' %></p>
<label class="ad-toggle"><input type="checkbox" name="<%= slot %>_enabled" value="1" <%= ad.enabled ? 'checked' : '' %>>Enable this placement</label>
<label for="<%= slot %>-type">Content type</label><select id="<%= slot %>-type" name="<%= slot %>_type" data-ad-type>
<% for (const [value, label] of [['embed', 'HTML / provider embed'], ['image', 'Image banner with link'], ['link', 'Sponsored link button']]) { %><option value="<%= value %>" <%= type === value ? 'selected' : '' %>><%= label %></option><% } %></select>
<div data-ad-fields="embed"><label for="<%= slot %>-html">HTML / embed code</label><textarea id="<%= slot %>-html" name="<%= slot %>_html" rows="8" maxlength="50000" spellcheck="false"><%= ad.html || '' %></textarea><p class="field-help">Paste the provider's HTML or script tag. Sandboxed providers only; scripts requiring page access or automatic popunders are unsupported.</p></div>
<div data-ad-fields="image"><label for="<%= slot %>-image">Image URL (HTTPS)</label><input id="<%= slot %>-image" name="<%= slot %>_image" type="url" maxlength="2000" value="<%= ad.image || '' %>" placeholder="https://example.com/banner.webp"></div>
<div data-ad-fields="image link"><label for="<%= slot %>-url">Destination URL (HTTPS)</label><input id="<%= slot %>-url" name="<%= slot %>_url" type="url" maxlength="2000" value="<%= ad.url || '' %>"><label for="<%= slot %>-label">Button text / image description</label><input id="<%= slot %>-label" name="<%= slot %>_label" maxlength="120" value="<%= ad.label || '' %>" placeholder="Visit sponsor"></div>
</fieldset><% } %><p class="field-help">Save applies to all public pages. Turning a placement off keeps its content for later.</p><button class="button" type="submit">Save advertisements</button></form></main><script src="/assets/admin-ads.js?v=1" defer></script><%- include('partials/footer') %>
