<%- include('partials/head') %><main class="container admin-page" id="main"><%- include('partials/admin-nav') %><a class="muted-link" href="/robloxploit-slimexdev">← All posts</a><div class="section-heading edit-heading"><div><h2><%= editing ? 'Edit script' : 'Add a new script' %></h2><p>Prepare something for the next adventure.</p></div></div>
<form method="post" enctype="multipart/form-data" action="<%= editing ? `/robloxploit-slimexdev/scripts/${script.id}/edit` : '/robloxploit-slimexdev/scripts' %>?_csrf=<%= csrf %>" class="editor-grid" id="script-form">
  <div><section class="form-panel"><h3>Post details</h3><label for="title">Title <span>*</span></label><input id="title" name="title" required maxlength="160" value="<%= script.title %>" placeholder="Example: Blox Fruits exploration script"><label for="game">Game name <span>*</span></label><input id="game" name="game" required maxlength="100" value="<%= script.game %>" placeholder="Example: Blox Fruits"><label for="description">Description <span>*</span></label><textarea id="description" name="description" rows="6" required maxlength="10000" placeholder="Describe what the script does and how to use it..."><%= script.description %></textarea><label for="content-type">Script content <span>*</span></label><select id="content-type" name="content_type"><option value="code" <%= script.script_url == null ? 'selected' : '' %>>Script code</option><option value="link" <%= script.script_url != null ? 'selected' : '' %>>Script link</option></select><p class="field-help">The code or link is only revealed after unlocking.</p><div id="code-field" <%= script.script_url != null ? 'hidden' : '' %>><label for="code">Script code <span>*</span></label><textarea class="code-editor" id="code" name="code" rows="12" <%= script.script_url == null ? 'required' : 'disabled' %> maxlength="300000" spellcheck="false" placeholder="-- Paste your Lua code here"><%= script.code %></textarea></div><div id="link-field" <%= script.script_url == null ? 'hidden' : '' %>><label for="script-url">Script link <span>*</span></label><input type="url" id="script-url" name="script_url" maxlength="2000" placeholder="https://example.com/script" value="<%= script.script_url || '' %>" <%= script.script_url != null ? 'required' : 'disabled' %>></div></section>

<section class="form-panel" id="task-editor"><h3>Unlock tasks</h3>
<label for="post-tasks-mode">Task configuration</label><select name="tasks_mode" id="post-tasks-mode"><option value="global" <%= !script.tasks_json ? 'selected' : '' %>>Use shared tasks</option><option value="custom" <%= script.tasks_json ? 'selected' : '' %>>Custom tasks for this post</option></select>
<p class="field-help">Custom tasks apply only to this post. Link wait time follows the shared settings; video tasks require 40 seconds.</p>
<input type="hidden" name="tasks_json" id="tasks-json">
<% let postSettings = settings; if (script.tasks_json) { try { const draft = JSON.parse(script.tasks_json); if (Array.isArray(draft) && draft.length && draft.every(t => t && taskTypes[t.type])) postSettings = { ...settings, tasks: draft }; } catch {} } %>
<fieldset id="post-custom-tasks" <%= !script.tasks_json ? 'hidden disabled' : '' %>><legend>Tasks for this post</legend><%- include('partials/task-editor', { settings: postSettings }) %>
</fieldset>
</section>
</div>
  <aside><section class="form-panel"><h3>Cover image</h3><label class="upload-zone" for="image"><img id="image-preview" src="<%= script.image || '/assets/cover-placeholder.svg' %>" alt="Cover preview"><span class="upload-prompt"><%- include('partials/icon', { name: 'upload' }) %><strong><%= editing ? 'Click or drag to replace' : 'Click or drag an image here' %></strong><small>JPG, PNG, WebP · up to 3 MB</small></span></label><input class="file-input" type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" <%= editing ? '' : 'required' %>><p class="field-help">Automatically converted to WebP and resized to a maximum of 1280 px.</p></section><section class="form-panel publish-panel"><h3>Post visibility</h3><label class="check-label"><input type="checkbox" name="published" value="1" <%= script.published ? 'checked' : '' %>><span>Publish on website<small>Uncheck to save this post as hidden.</small></span></label><button class="button full-width" type="submit"><%- include('partials/icon', { name: 'check' }) %><%= editing ? 'Save changes' : 'Save script' %></button><a class="button secondary full-width" href="/robloxploit-slimexdev">Cancel</a></section></aside>
</form></main><script src="/assets/admin-tasks.js?v=2" defer></script><%- include('partials/footer') %>
