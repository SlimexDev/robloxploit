<%- include('partials/head') %>
<main class="container admin-page" id="main"><%- include('partials/admin-nav') %>
  <div class="section-heading"><div><h2>Script code pages</h2><p>Standalone public pages with Copy, Raw and Download. No unlock tasks.</p></div><a class="button" href="/robloxploit-slimexdev/code/new">+ Add code page</a></div>
  <% if (!pages.length) { %><div class="empty-state"><h3>No code pages yet</h3><p>Create a page, paste your Lua script and publish it.</p></div><% } %>
  <div class="code-admin-list"><% pages.forEach(item => { %><article class="form-panel code-admin-row"><div><h3><a href="/robloxploit-slimexdev/code/<%= item.id %>/edit"><%= item.title %></a></h3><p><%= item.published ? 'Published' : 'Hidden' %> · Updated <%= date(item.updated_at) %></p><% if (item.published) { %><a class="text-link" href="/code/<%= item.id %>" target="_blank" rel="noopener">/code/<%= item.id %> ↗</a><% } %></div><div class="code-admin-actions"><a class="button secondary small-button" href="/robloxploit-slimexdev/code/<%= item.id %>/edit">Edit</a><form method="post" action="/robloxploit-slimexdev/code/<%= item.id %>/visibility"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary small-button"><%= item.published ? 'Hide' : 'Publish' %></button></form><form method="post" action="/robloxploit-slimexdev/code/<%= item.id %>/delete" data-confirm="Delete this code page permanently?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary small-button">Delete</button></form></div></article><% }) %></div>
  <% if (total > 30) { %><nav class="pagination" aria-label="Code pages"><% if (page > 1) { %><a class="button secondary" href="?page=<%= page - 1 %>">← Previous</a><% } %><span>Page <%= page %> / <%= Math.ceil(total / 30) %></span><% if (page * 30 < total) { %><a class="button secondary" href="?page=<%= page + 1 %>">Next →</a><% } %></nav><% } %>
  <p class="field-help">Manage shared banner and popup embeds in <a class="text-link" href="/robloxploit-slimexdev/ads">Advertisements</a>. Enabled ads also appear on published code pages.</p>
</main><%- include('partials/footer') %>
