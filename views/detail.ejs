<%- include('partials/head') %>
<main class="container detail-page" id="main">
  <nav class="breadcrumbs" aria-label="Breadcrumbs"><a href="/">Library</a><span>/</span><a href="/?<%= new URLSearchParams({ game: script.game }) %>#library"><%= script.game %></a><span>/</span><span>Script details</span></nav>
  <div class="detail-grid">
    <section class="script-info"><img class="detail-cover" src="<%= script.image %>" alt="Cover image <%= script.title %>" width="800" height="450"><div class="detail-meta"><span class="tag"><%= script.game %></span><span>Updated <%= date(script.updated_at) %></span></div><h1><%= script.title %></h1><div class="author-line"><span class="mini-logo">X</span><strong>RobloXploit</strong><span>•</span><span>Published by admin</span></div><div class="about-section"><h2>About this script</h2><p class="preserve-lines"><%= script.description %></p></div></section>
    <aside class="code-panel" aria-labelledby="code-title"><div class="code-panel-top"><div><%- include('partials/icon', { name: 'code' }) %><h2 id="code-title"><%= script.title %></h2></div><span class="language-tag">LUA</span></div><div id="locked-code" class="locked-code"><pre aria-hidden="true" class="blurred-code">-- RobloXploit Library
local adventure = {}

function adventure.start()
    print("Ready to explore")
    return true
end

adventure.start()
-- Unlock to see your script</pre><div class="lock-overlay"><span class="lock-emblem"><%- include('partials/icon', { name: 'lock' }) %></span><h3>Complete tasks to get your script.</h3><p>Complete <%= attempt.tasks.length %> quick tasks in order.</p><button class="button unlock-button" id="open-unlock" <%= configured ? '' : 'disabled' %>><%- include('partials/icon', { name: 'lock' }) %>Unlock Script <%- include('partials/icon', { name: 'arrow' }) %></button><% if (!configured) { %><p class="setup-note">Unlock tasks are not set up yet. Please check back soon.</p><% } %></div></div><div id="unlocked-code" hidden><div class="unlocked-label"><%- include('partials/icon', { name: 'check' }) %>Successfully unlocked</div><div id="code-result"><pre class="actual-code" tabindex="0"><code id="script-content"></code></pre><div class="script-actions"><button class="button" id="copy-script"><%- include('partials/icon', { name: 'copy' }) %>Copy script</button><a class="button secondary" id="raw-script" target="_blank" rel="noopener">Raw</a></div></div><a class="button full-width" id="get-script" target="_blank" rel="noopener noreferrer" hidden>Get script ↗</a></div></aside>
  </div>
  <a class="text-link back-link" href="/">← Discover more scripts</a>
</main>
<dialog class="unlock-dialog" id="unlock-dialog" aria-labelledby="unlock-title" data-token="<%= attempt.token %>">
  <button class="dialog-close" aria-label="Close unlock tasks" id="close-unlock">×</button>
  <div class="unlock-heading"><span class="unlock-emblem"><%- include('partials/icon', { name: 'lock' }) %></span><h2 id="unlock-title">Content locked</h2><p class="dialog-intro">Complete the steps below to get your script.</p></div>
  <div class="unlock-progress-card">
    <div class="progress-header"><span>Your progress</span><strong id="progress-label" role="status">0 / <%= attempt.tasks.length %></strong></div>
    <div id="unlock-progress" class="progress-segments" role="progressbar" aria-label="Unlock progress" aria-valuemin="0" aria-valuemax="<%= attempt.tasks.length %>" aria-valuenow="0"><% attempt.tasks.forEach(() => { %><span class="progress-segment" aria-hidden="true"></span><% }) %></div>
  </div>
  <div class="tasks">
    <% attempt.tasks.forEach((task, index) => { %>
      <div class="task-step" data-step="<%= index %>" <%= index ? 'hidden' : '' %>>
        <% if (task.type === 'watch') { %><div class="task-video" id="task-video-<%= index %>" hidden><iframe id="youtube-player-<%= index %>" class="youtube-player" title="YouTube video: <%= task.label %>" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div><% } %>
        <button type="button" class="task task-button <%= index === 0 ? 'current' : '' %>" data-task="<%= index %>" data-type="<%= task.type %>" data-video-id="<%= task.videoId || '' %>" aria-describedby="task-hint-<%= index %>" <%= index ? 'disabled' : '' %>>
          <span class="task-icon"><%- include('partials/icon', { name: task.type === 'custom' ? 'external' : 'play' }) %></span>
          <span class="task-copy"><span class="task-title"><%= task.label %></span><span class="task-hint" id="task-hint-<%= index %>"><%= index ? 'Complete the previous step first' : task.type === 'watch' ? 'Press play to continue · 40s left' : 'Click to start' %></span></span>
          <span class="task-status" aria-hidden="true"><%- include('partials/icon', { name: index ? 'lock' : 'arrow' }) %></span>
        </button>
      </div>
    <% }) %>
  </div>
  <aside class="unlock-ad-space" aria-label="Reserved advertisement placements"><span class="ad-space-label">Advertisement</span><div class="unlock-ad-grid" aria-hidden="true"><% for (let slot = 0; slot < 3; slot++) { %><div class="unlock-ad-placeholder"><span class="ad-image-placeholder"></span><span class="ad-line-placeholder"></span></div><% } %></div></aside>
  <p id="unlock-error" class="inline-error" role="alert"></p><button class="button reveal-button" id="reveal-script" disabled><%- include('partials/icon', { name: 'lock' }) %>Complete tasks to get your script</button>
</dialog>
<script src="/assets/unlock.js?v=1.2.0" defer></script>
<%- include('partials/footer') %>
