<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="RobloXploit — discover Roblox scripts, browse by game, unlock and copy your favorites.">
  <meta name="csrf-token" content="<%= csrf %>">
  <title><%= title %></title>
  <link rel="icon" href="/assets/robloxploit.png" type="image/png">
  <link rel="stylesheet" href="/assets/style.css?v=1.3.1">
  <script src="/assets/effects.js?v=1.0.7" defer></script>
  <script src="/assets/app.js?v=1.2.2" defer></script>
</head>
<body>
<canvas id="particles" aria-hidden="true"></canvas>
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="RobloXploit — Home"><img src="/assets/robloxploit.png" width="34" height="34" alt=""><span>Roblo<span class="accent">X</span>ploit<span class="brand-dot">.</span></span></a>
    <nav aria-label="Main navigation"><a href="/" class="<%= path === '/' || path.startsWith('/script/') ? 'active' : '' %>">Explore</a><a href="/#library">Script library</a></nav>
  </div>
</header>

<% if (ads.banner?.enabled) { %><aside class="ad-banner container" aria-label="Advertisement"><small>Advertisement</small><iframe title="Banner advertisement" src="/ads/content/banner" sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer" loading="lazy"></iframe></aside><% } %>
