<%- include('partials/head') %>
<main id="main">
  <section class="hero container">
    <div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span> ROBLOX SCRIPT LIBRARY</div><h1>Complete tasks.<br><span class="accent">Unlock scripts.</span></h1><p>Discover scripts for your Roblox world.<br>Find, unlock and copy — all in one place.</p><a class="text-link" href="#library">Explore the library <%- include('partials/icon', { name: 'arrow' }) %></a></div>
    <div class="hero-art" aria-hidden="true"><div class="hero-scene"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="hero-cube"><img src="/assets/robloxploit.png" width="124" height="124" alt=""></div><div class="floating-logo roblox-logo"><img src="/assets/roblox.svg" width="50" height="50" alt=""><span>ROBLOX</span></div><div class="floating-logo script-logo"><img src="/assets/script.svg" width="48" height="48" alt=""><span>LUA SCRIPT</span></div><div class="floating-label label-code"><span>&lt;/&gt;</span> Built for your next adventure</div><div class="floating-label label-lua"><i></i> Lua scripts</div><span class="spark spark-one">+</span><span class="spark spark-two">+</span></div></div>
  </section>
  <section class="library container" id="library" aria-labelledby="library-title">
    <div class="section-heading"><div><div class="eyebrow">THE COLLECTION</div><h2 id="library-title">Script library <span class="count"><%= total %></span></h2></div><span class="sort-label">↓ Newest first</span></div>
    <form class="search-bar" method="get" action="/#library" role="search"><%- include('partials/icon', { name: 'search' }) %><input name="q" aria-label="Search by title or game" placeholder="Search scripts or games..." value="<%= search %>" maxlength="100"><% if (game) { %><input type="hidden" name="game" value="<%= game %>"><% } %><button class="button">Search <%- include('partials/icon', { name: 'arrow' }) %></button></form>
    <div class="library-stats" aria-label="Library statistics">
      <div><span class="stats-dot" aria-hidden="true"></span><strong><%= games.reduce((sum, item) => sum + Number(item.count), 0).toLocaleString('en-US') %></strong><span>scripts</span></div>
      <div><%- include('partials/icon', { name: 'grid' }) %><strong><%= games.length.toLocaleString('en-US') %></strong><span>games</span></div>
      <div><%- include('partials/icon', { name: 'shield' }) %><strong>100%</strong><span>free access</span></div>
    </div>
    <div class="game-filters" aria-label="Filter by game"><a class="chip <%= !game ? 'selected' : '' %>" href="/?<%= new URLSearchParams({ q: search }) %>#library"><%- include('partials/icon', { name: 'grid' }) %>All games</a><% games.forEach(item => { %><a class="chip <%= game === item.game ? 'selected' : '' %>" href="/?<%= new URLSearchParams({ q: search, game: item.game }) %>#library"><%= item.game %><span><%= item.count %></span></a><% }) %></div>
    <% if (search || game) { %><div class="results-label"><%= total %> results<% if (search) { %> for “<%= search %>”<% } %><a href="/#library">Clear filters ×</a></div><% } %>
    <% if (scripts.length) { %><div class="script-grid"><% scripts.forEach(script => { %><a class="script-card" href="/script/<%= script.id %>" aria-label="Get script: <%= script.title %>"><span class="card-cover" aria-hidden="true"><img src="<%= script.image %>" alt="" width="640" height="360" loading="lazy"><span class="cover-badge"><%- include('partials/icon', { name: 'code' }) %> LUA SCRIPT</span><span class="cover-arrow"><%- include('partials/icon', { name: 'arrow' }) %></span></span><div class="card-body"><div class="card-meta"><span class="game-name"><%= script.game %></span><time><%= date(script.created_at) %></time></div><h3><%= script.title %></h3><p><%= script.description %></p><div class="card-bottom"><span><span class="mini-logo">X</span> RobloXploit</span><span class="card-get">Get script <%- include('partials/icon', { name: 'arrow' }) %></span></div></div></a><% }) %></div><% } else { %><div class="empty-state"><%- include('partials/icon', { name: 'search' }) %><h3><%= search || game ? 'No matching scripts found' : 'Your next adventure starts here' %></h3><p><%= search || game ? 'Try a different game or clear the filters.' : 'New scripts will appear here once they are published.' %></p><% if (search || game) { %><a class="button secondary" href="/#library">View all scripts</a><% } %></div><% } %>
    <% if (total > 12) { %><nav class="pagination" aria-label="Pagination"><% if (page > 1) { %><a class="button secondary" href="<%= pageUrl(page - 1) %>#library">← Previous</a><% } %><span>Page <%= page %> / <%= Math.ceil(total / 12) %></span><% if (page * 12 < total) { %><a class="button secondary" href="<%= pageUrl(page + 1) %>#library">Next →</a><% } %></nav><% } %>
    <div class="library-note"><%- include('partials/icon', { name: 'shield' }) %><div><strong>No account needed.</strong> Complete the unlock steps to get your favorite scripts.</div></div>
  </section>
</main>
<%- include('partials/footer') %>
