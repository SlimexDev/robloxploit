<%- include('partials/head') %>
<main class="container admin-page" id="main"><%- include('partials/admin-nav') %>
  <div class="stat-row"><div><span>Total posts</span><strong><%= counts.total %></strong></div><div><span>Published</span><strong><%= counts.published %><i class="status-dot"></i></strong></div><div><span>Hidden</span><strong><%= counts.hidden %></strong></div></div>
  <section class="admin-section"><div class="section-heading"><div><h2>Manage posts</h2><p>Your script library, at your fingertips.</p></div><a class="button" href="/robloxploit-slimexdev/new"><%- include('partials/icon', { name: 'plus' }) %>Add script</a></div>
  <form class="admin-filters" method="get"><div class="input-icon"><%- include('partials/icon', { name: 'search' }) %><input name="q" aria-label="Search posts" placeholder="Search by title or game..." value="<%= search %>" maxlength="100"></div><select name="status" aria-label="Post status"><option value="">All statuses</option value="published" <%= status === 'published' ? 'selected' : '' %>>Published</option><option value="hidden" <%= status === 'hidden' ? 'selected' : '' %>>Hidden</option></select><button class="button secondary">Filter</button></form>
  <% if (scripts.length) { %><div class="table-scroll"><table class="admin-table"><thead><tr><th>Posts</th><th>Status</th><th>Published on</th><th>Actions</th></tr></thead><tbody><% scripts.forEach(script => { %><tr><td><a class="table-post" href="/robloxploit-slimexdev/scripts/<%= script.id %>/edit"><img src="<%= script.image %>" alt="" width="88" height="54"><div><strong><%= script.title %></strong><span><%= script.game %></span></div></a></td><td><span class="status-badge <%= script.published ? 'published' : 'hidden-status' %>"><i></i><%= script.published ? 'Published' : 'Hidden' %></span></td><td class="date-cell"><%= date(script.created_at) %></td><td><div class="table-actions"><a href="/robloxploit-slimexdev/scripts/<%= script.id %>/edit" aria-label="Edit <%= script.title %>">Edit</a><form method="post" action="/robloxploit-slimexdev/scripts/<%= script.id %>/visibility"><input type="hidden" name="_csrf" value="<%= csrf %>"><button><%= script.published ? 'Hide' : 'Publish' %></button></form><form method="post" action="/robloxploit-slimexdev/scripts/<%= script.id %>/delete" data-confirm="Delete this post? Its code and cover image will be permanently removed."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Delete</button></form></div></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state"><%- include('partials/icon', { name: 'code' }) %><h3>No posts found</h3><p>Add a new script or adjust the filters.</p></div><% } %>
  <% if (total > 30) { %><nav class="pagination" aria-label="Post pagination"><% if (page > 1) { %><a class="button secondary" href="<%= pageUrl(page - 1) %>">← Previous</a><% } %><span>Page <%= page %></span><% if (page * 30 < total) { %><a class="button secondary" href="<%= pageUrl(page + 1) %>">Next →</a><% } %></nav><% } %>
  </section>
</main><%- include('partials/footer') %>
