<%- include('partials/head') %><main class="container admin-page" id="main"><%- include('partials/admin-nav') %><div class="section-heading"><div><h2>Unlock tasks</h2><p>One shared configuration for every script in your library.</p></div></div>
<div class="settings-grid"><form class="form-panel" method="post" action="/robloxploit-slimexdev/settings"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>YouTube links</h3><label for="channel_url">Channel to subscribe to</label><input type="url" id="channel_url" name="channel_url" value="<%= settings.channel_url %>" placeholder="https://www.youtube.com/@yourchannel" maxlength="500" required><label for="video_url">Shared video</label><input type="url" id="video_url" name="video_url" value="<%= settings.video_url %>" placeholder="https://www.youtube.com/watch?v=..." maxlength="500" required><p class="field-help">Used for watching, liking and commenting.</p><div class="form-divider"></div><h3>Task behavior</h3><fieldset class="mode-options"><legend>Like and comment</legend><label class="radio-card"><input type="radio" name="mode" value="combined" <%= settings.combined ? 'checked' : '' %>><span><strong>Combine into one step</strong><small>3 tasks in total</small></span></label><label class="radio-card"><input type="radio" name="mode" value="split" <%= !settings.combined ? 'checked' : '' %>><span><strong>Split into two steps</strong><small>4 tasks in total</small></span></label></fieldset><label for="wait_seconds">Wait time per task (seconds)</label><input type="number" id="wait_seconds" name="wait_seconds" min="1" max="120" required value="<%= settings.wait_seconds %>"><p class="field-help">Tasks must always be completed in order.</p><button class="button" type="submit"><%- include('partials/icon', { name: 'check' }) %>Save settings</button></form><aside class="settings-note form-panel"><span class="lock-emblem"><%- include('partials/icon', { name: 'lock' }) %></span><h3>Unlock flow</h3><ol><li>Subscribe to channel</li><li>Watch video</li><li>Like & comment <small>(or two separate steps)</small></li><li>Reveal and copy the code</li></ol><p>Visitors repeat the tasks every time they open or reload a script page.</p><div class="alert">The system records link openings and wait time. It does not verify actual YouTube subscriptions, views, likes or comments.</div></aside></div></main><%- include('partials/footer') %>
