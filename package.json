{
  "name": "robloxploit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "dev": "node --env-file=.env --watch server/index.js",
    "setup": "node --env-file=.env scripts/setup.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file=.env --test tests/integration/*.test.js",
    "setup:cloud": "node --env-file=.env.production.local scripts/setup-cloud.js",
    "start:cloud": "node --env-file=.env.production.local server/index.js",
    "test:postgres": "node --env-file-if-exists=.env.postgres.test --test tests/postgres/*.test.js",
    "migrate:cloud": "node --env-file=.env --env-file=.env.production.local scripts/migrate-to-supabase.js",
    "check:release": "node scripts/check-release.js"
  },
  "dependencies": {
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  }
}
