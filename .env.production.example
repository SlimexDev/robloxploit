# Copy to .env.production.local for setup on your own computer. Never commit it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Use the Transaction pooler URI from Supabase Connect. Do not add sslmode=no-verify.
# Optional: Supabase database CA certificate PEM; encode line breaks as \n.
DATABASE_CA_CERT=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=script-covers
# Used only by setup:cloud; do not put these two in Vercel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
# Vercel uses HTTPS. For local cloud testing set this to development.
NODE_ENV=production
